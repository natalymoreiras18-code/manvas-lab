/* ---------- Foro (almacenamiento local del navegador) ---------- */
var STATES=[['recibido','Recibido'],['evaluacion','En evaluación'],['equipo','Equipo en camino'],['recuperado','Recuperado']];
var LABEL={};STATES.forEach(function(s){LABEL[s[0]]=s[1]});
var KEY='ec_foro_v1',mem=null;
function now(){return Date.now()}
function seed(){
  var d=86400000,t=now();
  return {reports:[
    {id:'s1',title:'Esquina de calle Viollier con contenedores desbordados',kind:'Esquina o rincón',comuna:'Santiago',problem:'Basura y escombros',body:'Los contenedores se llenan antes de cada retiro y la basura queda en la vereda. Hace falta un punto de reciclaje cerrado y señalizado.',who:'Ejemplo del equipo',createdAt:t-3*d,state:'evaluacion',base:14,mine:false,replies:[{who:'Vecina del sector',text:'Paso por ahí todos los días y confirmo que es así.',createdAt:t-2*d}]},
    {id:'s2',title:'Multicancha sin iluminación',kind:'Cancha o multicancha',comuna:'Ñuñoa',problem:'Iluminación deficiente',body:'Después de las 18:00 no se puede usar. Los niños juegan en la calle por eso.',who:'Ejemplo del equipo',createdAt:t-6*d,state:'equipo',base:22,mine:false,replies:[]},
    {id:'s3',title:'Plaza del pasaje con bancas rotas',kind:'Plaza',comuna:'Estación Central',problem:'Mobiliario roto o robado',body:'Las bancas fueron retiradas y no quedó dónde sentarse. Las personas mayores ya no la usan.',who:'Ejemplo del equipo',createdAt:t-12*d,state:'recuperado',base:31,mine:false,replies:[]}
  ]};
}
function load(){
  try{var r=localStorage.getItem(KEY);if(r){mem=JSON.parse(r);return}}catch(e){}
  mem=mem||seed();
}
function save(){try{localStorage.setItem(KEY,JSON.stringify(mem));return true}catch(e){return false}}
load();
var filter='todos',sortBy='apoyos',openThreads={},drafts={};
var toastT;
function toast(msg){var t=$('#toast');t.textContent=msg;t.hidden=false;clearTimeout(toastT);toastT=setTimeout(function(){t.hidden=true},4200)}
var rtf=new Intl.RelativeTimeFormat('es-CL',{numeric:'auto'});
function ago(ts){
  if(!ts)return '';
  var m=Math.round((ts-now())/60000),a=Math.abs(m);
  if(a<1)return 'hace un momento';
  if(a<60)return rtf.format(m,'minute');
  if(a<1440)return rtf.format(Math.round(m/60),'hour');
  return rtf.format(Math.round(m/1440),'day');
}
function getName(){try{return localStorage.getItem('ec_name')||''}catch(e){return ''}}
function setName(v){try{localStorage.setItem('ec_name',v)}catch(e){}}
function votes(r){return r.base+(r.mine?1:0)}

function renderChips(){
  var box=$('#chips');box.replaceChildren();
  [['todos','Todos']].concat(STATES).forEach(function(s){
    var n=s[0]==='todos'?mem.reports.length:mem.reports.filter(function(r){return r.state===s[0]}).length;
    box.append(h('button',{type:'button',class:'chip','aria-pressed':String(filter===s[0]),onclick:function(){filter=s[0];renderForum()}},s[1]+' · '+n));
  });
}
function threadFor(r){
  var box=h('div',{class:'thread'});
  r.replies.forEach(function(x){box.append(h('div',{class:'reply'},h('span',{class:'meta',text:(x.who||'Vecino/a')+' · '+ago(x.createdAt)}),h('p',{text:x.text})))});
  if(!r.replies.length)box.append(h('p',{class:'note',text:'Todavía no hay comentarios. Cuenta si conoces el lugar o si quieres ayudar.'}));
  var ta=h('textarea',{maxlength:'400','aria-label':'Escribe un comentario sobre '+r.title,placeholder:'Escribe un comentario'});
  ta.value=drafts[r.id]||'';ta.addEventListener('input',function(){drafts[r.id]=ta.value});
  var nm=h('input',{type:'text',class:'nm',maxlength:'40','aria-label':'Tu nombre (opcional)',placeholder:'Tu nombre (opcional)'});nm.value=getName();
  var send=h('button',{type:'button',class:'btn btn-sm',text:'Comentar',onclick:function(){
    var text=ta.value.trim();if(text.length<2){toast('Escribe un comentario antes de enviarlo.');return}
    var who=nm.value.trim();if(who)setName(who);
    r.replies.push({who:who,text:text,createdAt:now()});drafts[r.id]='';save();renderForum();
  }});
  box.append(h('div',{class:'reply-form'},ta,send,nm));
  return box;
}
function renderForum(){
  var rs=mem.reports,eq=0,rc=0;
  rs.forEach(function(r){if(r.state==='equipo')eq++;if(r.state==='recuperado')rc++});
  $('#n-total').textContent=rs.length;$('#n-equipo').textContent=eq;$('#n-rec').textContent=rc;
  renderChips();
  var list=$('#list');list.replaceChildren();
  var shown=rs.filter(function(r){return filter==='todos'||r.state===filter});
  shown.sort(sortBy==='apoyos'?function(a,b){return votes(b)-votes(a)||b.createdAt-a.createdAt}:function(a,b){return b.createdAt-a.createdAt});
  if(!shown.length){list.append(h('div',{class:'empty'},h('b',{text:rs.length?'No hay lugares con este estado':'Aún no hay lugares reportados'}),h('span',{text:rs.length?'Prueba con otro filtro.':'Sé la primera persona en enviar uno.'})));return}
  shown.forEach(function(r){
    list.append(h('article',{class:'card'},
      h('div',{class:'card-top'},h('span',{class:'meta',text:[r.kind,r.comuna,ago(r.createdAt)].filter(Boolean).join(' · ')}),h('span',{class:'st '+r.state,text:LABEL[r.state]})),
      h('h3',{text:r.title}),h('p',{text:r.body}),
      (r.photos&&r.photos.length)?h('div',{class:'photos'},r.photos.map(function(src,i){
        return h('button',{type:'button','aria-label':'Ampliar foto '+(i+1)+' de '+r.title,onclick:function(){openPhoto(src)}},h('img',{src:src,alt:'Foto '+(i+1)+' de '+r.title,loading:'lazy'}));
      })):null,
      h('div',null,h('span',{class:'tag',text:r.problem||''}),r.who?h('span',{class:'meta',style:'margin-left:10px',text:'Reporta: '+r.who}):null),
      h('div',{class:'acts'},
        h('button',{type:'button',class:'act','aria-pressed':String(!!r.mine),onclick:function(){r.mine=!r.mine;save();renderForum()}},r.mine?'Apoyado':'Apoyar',h('b',{text:String(votes(r))})),
        h('button',{type:'button',class:'act plain','aria-expanded':String(!!openThreads[r.id]),onclick:function(){openThreads[r.id]=!openThreads[r.id];renderForum()}},'Comentarios ('+r.replies.length+')')),
      openThreads[r.id]?threadFor(r):null));
  });
}
/* Fotos: se reducen en el navegador antes de guardarlas */
var pending=[],MAXP=3;
function openPhoto(src){var d=$('#lb');$('img',d).src=src;if(d.showModal)d.showModal();else d.setAttribute('open','')}
$('#lb-x').addEventListener('click',function(){var d=$('#lb');if(d.close)d.close();else d.removeAttribute('open')});
$('#lb').addEventListener('click',function(e){if(e.target===this&&this.close)this.close()});
function shrink(file){
  return new Promise(function(res,rej){
    var fr=new FileReader();
    fr.onerror=function(){rej()};
    fr.onload=function(){
      var im=new Image();
      im.onerror=function(){rej()};
      im.onload=function(){
        var M=960,s=Math.min(1,M/Math.max(im.width,im.height)),w=Math.round(im.width*s),hh=Math.round(im.height*s);
        var c=document.createElement('canvas');c.width=w;c.height=hh;
        var x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,w,hh);x.drawImage(im,0,0,w,hh);
        res(c.toDataURL('image/jpeg',.72));
      };
      im.src=fr.result;
    };
    fr.readAsDataURL(file);
  });
}
function renderPrev(){
  var box=$('#prev');box.replaceChildren();
  pending.forEach(function(src,i){
    box.append(h('div',{class:'thumb'},h('img',{src:src,alt:'Vista previa de la foto '+(i+1)}),
      h('button',{type:'button','aria-label':'Quitar foto '+(i+1),text:'×',onclick:function(){pending.splice(i,1);renderPrev();fieldErr('photo','')}})));
  });
}
$('#f-photo').addEventListener('change',function(e){
  var files=Array.prototype.slice.call(e.target.files||[]),input=e.target;
  var imgs=files.filter(function(f){return /^image\//.test(f.type)});
  var room=MAXP-pending.length,msg='';
  if(imgs.length<files.length)msg='Solo se aceptan imágenes.';
  if(imgs.length>room){msg='Puedes subir hasta '+MAXP+' fotos.';imgs=imgs.slice(0,Math.max(0,room))}
  fieldErr('photo',msg);
  Promise.all(imgs.map(function(f){return shrink(f).catch(function(){return null})})).then(function(out){
    out.forEach(function(s){if(s&&pending.length<MAXP)pending.push(s)});
    if(out.some(function(s){return !s}))fieldErr('photo','No se pudo leer una de las imágenes.');
    renderPrev();input.value='';
  });
});

function fieldErr(id,msg,input){
  var e=$('#e-'+id);if(!e)return;e.hidden=!msg;e.textContent=msg||'';
  if(input){if(msg)input.setAttribute('aria-invalid','true');else input.removeAttribute('aria-invalid')}
}
var form=$('#rep-form');$('#f-name').value=getName();
form.addEventListener('submit',function(ev){
  ev.preventDefault();
  var f={title:$('#f-title'),kind:$('#f-kind'),comuna:$('#f-comuna'),problem:$('#f-problem'),body:$('#f-body'),who:$('#f-name')};
  var ok=true;
  var chk=function(key,bad,msg){fieldErr(key,bad?msg:'',f[key]);if(bad)ok=false};
  chk('title',f.title.value.trim().length<4,'Escribe el nombre del lugar.');
  chk('kind',!f.kind.value,'Elige el tipo de lugar.');
  chk('comuna',f.comuna.value.trim().length<2,'Indica la comuna.');
  chk('body',f.body.value.trim().length<10,'Cuéntanos un poco más (mínimo 10 caracteres).');
  if(!ok)return;
  var who=f.who.value.trim();if(who)setName(who);
  var rep={id:'u'+now(),title:f.title.value.trim(),kind:f.kind.value,comuna:f.comuna.value.trim(),problem:f.problem.value,body:f.body.value.trim(),who:who,createdAt:now(),state:'recibido',base:0,mine:false,replies:[],photos:pending.slice()};
  mem.reports.push(rep);
  if(!save()){
    mem.reports.pop();
    if(rep.photos.length){rep.photos=[];mem.reports.push(rep);
      if(save()){toast('No hubo espacio para las fotos, el reporte se guardó sin ellas.')}
      else{mem.reports.pop();toast('El navegador no tiene espacio para guardar más reportes.');return}
    }else{toast('El navegador no tiene espacio para guardar más reportes.');return}
  }else{toast('Listo, tu lugar quedó en el foro.')}
  form.reset();pending=[];renderPrev();f.who.value=getName();filter='todos';sortBy='recientes';$('#sort').value='recientes';renderForum();
  toast('Listo, tu lugar quedó en el foro.');
});
$('#sort').addEventListener('change',function(e){sortBy=e.target.value;renderForum()});
renderForum();

/* ---------- Formulario de aliados (demostración) ---------- */
$('#al-form').addEventListener('submit',function(ev){
  ev.preventDefault();
  var org=$('#a-org'),con=$('#a-contact'),ok=true;
  var bo=org.value.trim().length<2,bc=con.value.trim().length<5;
  fieldErr('org',bo?'Escribe el nombre de la organización.':'',org);fieldErr('contact',bc?'Déjanos un correo o teléfono.':'',con);
  if(bo||bc)return;
  ev.target.reset();toast('Gracias. Esta es una demostración: aún no se envía a un servidor.');
});

/* ---------- Atajo secreto: escribir "tareas" abre el Drive del equipo ---------- */
(function(){
  var secret='tareas',buf='';
  document.addEventListener('keydown',function(e){
    var t=e.target,tag=t&&t.tagName;
    if(tag==='INPUT'||tag==='TEXTAREA'||tag==='SELECT'||(t&&t.isContentEditable))return;
    if(e.ctrlKey||e.metaKey||e.altKey||e.key.length!==1)return;
    buf=(buf+e.key.toLowerCase()).slice(-secret.length);
    if(buf===secret){buf='';window.open('https://drive.google.com/drive/folders/1BLG_MDrF1AHz-URTuoaib3sQsgi5iV6x','_blank','noopener,noreferrer')}
  });
})();

/* ---------- Aparición al scroll y menú activo ---------- */
var rv=document.querySelectorAll('.rv');
if('IntersectionObserver' in window){
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
  rv.forEach(function(el){io.observe(el)});
}else{rv.forEach(function(el){el.classList.add('in')})}
var links=document.querySelectorAll('.nav-links a');
if('IntersectionObserver' in window){
  var so=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){links.forEach(function(a){a.classList.toggle('on',a.getAttribute('href')==='#'+e.target.id)})}})},{rootMargin:'-45% 0px -50% 0px'});
  links.forEach(function(a){var s=document.getElementById(a.getAttribute('href').slice(1));if(s)so.observe(s)});
}
})();
</script>
