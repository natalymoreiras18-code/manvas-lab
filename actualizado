<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Viollier Vive · Recuperamos la calle Viollier junto a los vecinos</title>
<meta name="description" content="Propuesta de recuperación de espacios públicos en calle Viollier, Santiago. Proyecto CD1201, FCFM, Universidad de Chile. Equipo Manva's.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Poppins:wght@400;500;600&display=swap">
<style>
:root{
  --bg:#F7F9F9; --surface:#EAF0F0; --card:#FFFFFF; --ink:#16212B; --on-ink:#F7F9F9; --muted:#4A5864; --line:#D3D9DE;
  --accent:#2A9D8F; --accent-ink:#1B6E64; --accent-soft:#D7EFEC; --signal:#F4A261; --signal-soft:#FDEBDD; --on-signal:#16212B;
  --ring:#1B5FD1; --tape:#16212B; --danger:#C0392B;
  --btn-bg:#1F7A6F; --btn-bg-hover:#1B6E64; --btn-text:#fff;
  --hero-a:#D7EFEC; --hero-b:#FDEBDD;
  --shadow:0 10px 30px -12px rgba(22,33,43,.25);
  --mark:linear-gradient(transparent 62%,#F4A261 62%,#F4A261 90%,transparent 90%);
  --mark-g:linear-gradient(transparent 62%,#7FD6CA 62%,#7FD6CA 90%,transparent 90%);
  --f-display:'Montserrat',system-ui,-apple-system,'Segoe UI',sans-serif;
  --f-body:'Poppins',system-ui,-apple-system,'Segoe UI',sans-serif;
  --step--1:clamp(.8125rem,.79rem + .1vw,.875rem);
  --step-0:clamp(1rem,.96rem + .2vw,1.125rem);
  --step-1:clamp(1.125rem,1.05rem + .4vw,1.375rem);
  --step-3:clamp(1.75rem,1.4rem + 1.8vw,2.5rem);
  --step-4:clamp(2.1rem,1.3rem + 3.8vw,4rem);
  --gutter:clamp(1rem,4vw,2.75rem);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#111A21; --surface:#18232C; --card:#212F3A; --ink:#F4F7F7; --on-ink:#111A21; --muted:#A8B5BF; --line:#33424E;
    --accent-ink:#5FD0C2; --accent-soft:#1B3F3B; --signal-soft:#45331F; --ring:#7FB2FF; --tape:#0B1116; --danger:#F1948A;
    --hero-a:#16322F; --hero-b:#2F2418; --shadow:0 10px 30px -12px rgba(0,0,0,.6);
    --mark:none; --mark-g:none; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#111A21; --surface:#18232C; --card:#212F3A; --ink:#F4F7F7; --on-ink:#111A21; --muted:#A8B5BF; --line:#33424E;
  --accent-ink:#5FD0C2; --accent-soft:#1B3F3B; --signal-soft:#45331F; --ring:#7FB2FF; --tape:#0B1116; --danger:#F1948A;
  --hero-a:#16322F; --hero-b:#2F2418; --shadow:0 10px 30px -12px rgba(0,0,0,.6);
  --mark:none; --mark-g:none; color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--step-0)/1.65 var(--f-body);overflow-x:hidden;-webkit-text-size-adjust:100%}
h1,h2,h3,h4{font-family:var(--f-display);line-height:1.12;text-wrap:balance;margin:0;overflow-wrap:break-word}
p,ul,ol,dl,dd,figure{margin:0}
p{max-width:65ch}
ul,ol{padding:0;list-style:none}
button,input,select,textarea{font:inherit;color:inherit}
a{color:var(--ink);text-decoration-color:var(--signal);text-decoration-thickness:2px;text-underline-offset:.2em}
:focus-visible{outline:3px solid var(--ring);outline-offset:2px}
.wrap{max-width:1200px;margin-inline:auto;padding-inline:var(--gutter)}
.eyebrow{font:600 .75rem/1.2 var(--f-body);letter-spacing:.12em;text-transform:uppercase;color:var(--accent-ink)}
.mark{background-image:var(--mark);color:var(--ink);-webkit-box-decoration-break:clone;box-decoration-break:clone}
.mark.g{background-image:var(--mark-g)}
:root[data-theme="dark"] .mark,:root:not([data-theme="light"]) .mark{}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .mark{color:var(--signal)}:root:not([data-theme="light"]) .mark.g{color:#5FD0C2}}
:root[data-theme="dark"] .mark{color:var(--signal)}:root[data-theme="dark"] .mark.g{color:#5FD0C2}
.tape{height:12px;background:repeating-linear-gradient(-45deg,var(--signal) 0 14px,var(--tape) 14px 28px)}

/* Nav */
.nav{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav-in{display:flex;align-items:center;gap:12px;padding-block:10px}
.brand{font:800 1.2rem/1 var(--f-display);text-decoration:none;display:flex;align-items:center;gap:8px;white-space:nowrap}
.brand i{width:14px;height:14px;background:var(--signal);border:2px solid var(--ink);display:inline-block;transform:rotate(45deg)}
.nav-links{display:flex;gap:2px;margin-left:auto;overflow-x:auto;scrollbar-width:none;min-width:0}
.nav-links::-webkit-scrollbar{display:none}
.nav-links a{font:500 .8125rem/1 var(--f-body);text-decoration:none;padding:10px;color:var(--muted);white-space:nowrap;border-radius:999px}
.nav-links a:hover,.nav-links a.on{color:var(--ink);background:var(--surface)}
.theme{width:40px;height:40px;border-radius:50%;border:1.5px solid var(--line);background:var(--card);cursor:pointer;display:grid;place-items:center;flex:none}
@media (max-width:760px){.nav-in{flex-wrap:wrap}.nav-links{order:3;flex-basis:100%;margin-left:-10px}.theme{margin-left:auto}}

/* Botones */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:3rem;padding:.75rem 1.6rem;font:500 1rem/1.2 var(--f-body);text-decoration:none;cursor:pointer;color:var(--btn-text);background:var(--btn-bg);border:2px solid transparent;border-radius:999px;transition:background-color .15s,transform .15s,box-shadow .15s}
.btn:hover{background:var(--btn-bg-hover);transform:translateY(-2px);box-shadow:var(--shadow)}
.btn:disabled{opacity:.55;cursor:not-allowed;transform:none;box-shadow:none}
.btn--ocre{background:var(--signal);color:var(--on-signal)}
.btn--ocre:hover{background:#EC9145}
.btn-sm{min-height:2.5rem;font-size:.875rem;padding:.5rem 1.1rem}

/* Hero */
.hero-bg{background:radial-gradient(900px 420px at 85% 0%,var(--hero-b),transparent 70%),radial-gradient(800px 480px at 0% 20%,var(--hero-a),transparent 70%)}
.hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(24px,4vw,56px);align-items:center;padding-block:clamp(36px,6vw,80px)}
.hero h1{font-size:var(--step-4);font-weight:800;letter-spacing:-.02em;margin-block:1rem 1.25rem}
.lead{font-size:var(--step-1);max-width:54ch}
.cta-row{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.75rem}
.badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:1.75rem}
.badge{font:500 .75rem/1 var(--f-body);padding:8px 12px;border-radius:999px;background:var(--card);border:1px solid var(--line);color:var(--muted)}
.hero-fig{margin:0;min-width:0;position:relative}
.hero-fig figcaption{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 16px;margin-top:10px;font:400 .75rem/1.4 var(--f-body);color:var(--muted)}
.hero-fig .ba{box-shadow:var(--shadow)}
@media (max-width:860px){.hero{grid-template-columns:minmax(0,1fr)}}

/* Antes / después */
.ba{position:relative;aspect-ratio:16/9;max-width:100%;overflow:hidden;--p:50%;border:2px solid var(--ink);border-radius:14px;background:#999;touch-action:pan-y}
.ba img{display:block;width:100%;height:100%;object-fit:cover;user-select:none;-webkit-user-drag:none}
.ba-layer{position:absolute;inset:0}
.ba-before{clip-path:inset(0 calc(100% - var(--p)) 0 0)}
.ba-handle{position:absolute;top:0;bottom:0;left:var(--p);width:4px;margin-left:-2px;background:var(--signal);pointer-events:none}
.ba-handle span{position:absolute;top:50%;left:50%;width:44px;height:44px;margin:-22px 0 0 -22px;background:var(--signal);border:2px solid var(--ink);border-radius:50%;display:grid;place-items:center;font:800 .95rem/1 var(--f-display);color:var(--on-signal);letter-spacing:-.05em}
.ba-tag{position:absolute;top:10px;padding:5px 9px;background:var(--ink);color:var(--on-ink);font:500 .6875rem/1 var(--f-body);letter-spacing:.1em;text-transform:uppercase;pointer-events:none;border-radius:4px}
.ba-tag.b{left:10px}.ba-tag.a{right:10px}
.ba-range{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:ew-resize;-webkit-appearance:none;appearance:none;background:transparent}
.ba:focus-within{outline:3px solid var(--ring);outline-offset:2px}

/* Secciones */
.sec{padding-block:clamp(52px,8vw,100px)}
.sec.alt{background:var(--surface)}
.sec-head{display:grid;gap:12px;margin-bottom:clamp(28px,4vw,48px);max-width:820px}
.sec-head h2{font-size:var(--step-3);font-weight:800;letter-spacing:-.015em}
.pill{display:inline-block;width:fit-content;font:500 .6875rem/1 var(--f-body);letter-spacing:.06em;text-transform:uppercase;padding:6px 9px;border:1px dashed var(--muted);color:var(--muted);border-radius:4px}

/* Evidencia */
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-bottom:clamp(28px,4vw,48px)}
.fact{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px;display:grid;gap:4px}
.fact b{font:800 clamp(2.25rem,1.6rem + 2.2vw,3.25rem)/1 var(--f-display);color:var(--accent-ink)}
.fact span{font:500 .75rem/1.3 var(--f-body);letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
.finds{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.find{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px;display:grid;gap:10px;align-content:start;position:relative;overflow:hidden}
.find::before{content:"";position:absolute;inset:0 auto 0 0;width:6px;background:var(--signal)}
.find:nth-child(2)::before{background:var(--accent)}
.find:nth-child(3)::before{background:var(--ink)}
.find h3{font-size:1.2rem}
.find p{font-size:var(--step--1)}
.quote{font-size:.875rem;color:var(--muted);border-top:1px dashed var(--line);padding-top:10px;font-style:italic}
@media (max-width:900px){.finds{grid-template-columns:minmax(0,1fr)}}

/* Pilares */
.pillars{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:clamp(32px,5vw,56px)}
.pillar{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px;display:grid;gap:10px;align-content:start;transition:transform .2s,box-shadow .2s}
.pillar:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.pillar svg{width:44px;height:44px}
.pillar h3{font-size:1.15rem}
.pillar p{font-size:var(--step--1);color:var(--muted)}
.pillar small{font:500 .6875rem/1.4 var(--f-body);letter-spacing:.05em;text-transform:uppercase;color:var(--accent-ink)}
@media (max-width:980px){.pillars{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:520px){.pillars{grid-template-columns:minmax(0,1fr)}}

/* Tabs propuestas */
.tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px}
.tab{font:500 .875rem/1.2 var(--f-body);padding:12px 18px;border-radius:999px;border:1.5px solid var(--line);background:var(--card);cursor:pointer;display:inline-flex;gap:8px;align-items:center}
.tab span{width:22px;height:22px;border-radius:50%;background:var(--surface);display:grid;place-items:center;font-size:.75rem;font-weight:600}
.tab[aria-selected=true]{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.tab[aria-selected=true] span{background:var(--signal);color:var(--on-signal)}
.panel{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:clamp(20px,3vw,36px);display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(20px,3vw,40px);box-shadow:var(--shadow)}
.panel[hidden]{display:none}
.panel h3{font-size:clamp(1.4rem,1.2rem + 1vw,2rem);margin-block:8px 12px}
.panel .desc{font-size:var(--step--1);color:var(--muted)}
.attrs{display:grid;gap:12px;align-content:start}
.attr{display:grid;grid-template-columns:auto 1fr;gap:14px;padding:14px 16px;background:var(--surface);border-radius:14px;align-items:start}
.attr em{font:800 1.4rem/1 var(--f-display);font-style:normal;color:var(--signal)}
.attr h4{font-size:1.02rem;margin-bottom:4px}
.attr p{font-size:.875rem}
@media (max-width:860px){.panel{grid-template-columns:minmax(0,1fr)}}

/* Expectativas */
.goals{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.goal{display:grid;grid-template-columns:auto 1fr;gap:16px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px}
.goal i{width:42px;height:42px;border-radius:12px;background:var(--accent-soft);color:var(--accent-ink);display:grid;place-items:center;font:800 1.1rem/1 var(--f-display);font-style:normal}
.goal h3{font-size:1.1rem;margin-bottom:4px}
.goal p{font-size:var(--step--1);color:var(--muted)}
.ods{display:flex;flex-wrap:wrap;gap:14px;margin-top:28px}
.ods div{flex:1 1 260px;border-radius:16px;padding:18px 20px;color:#fff;display:grid;gap:4px}
.ods b{font:800 1.6rem/1 var(--f-display)}
.ods span{font-size:.875rem}
.ods .o11{background:#C2571A}.ods .o3{background:#1E7B4F}
.route{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-top:clamp(32px,5vw,56px);counter-reset:r}
.route li{border-top:6px solid var(--ink);padding-top:12px;display:grid;gap:4px;align-content:start;font-size:var(--step--1)}
.route li b{font:700 1rem/1.2 var(--f-display)}
.route li.done{border-top-color:var(--accent)}
.route li.now{border-top-color:var(--signal)}
.route li span{font:500 .6875rem/1 var(--f-body);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
@media (max-width:900px){.goals{grid-template-columns:minmax(0,1fr)}.route{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* Casos */
.cases{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:clamp(20px,3vw,40px)}
.case{display:grid;gap:12px;align-content:start;min-width:0}
.case h3{font-size:clamp(1.2rem,1.1rem + .5vw,1.45rem)}
.case p{font-size:var(--step--1)}
.spec{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;border-top:1px solid var(--line);padding-top:10px}
.spec dt{font:400 .6875rem/1.2 var(--f-body);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.spec dd{font:600 .875rem/1.3 var(--f-body)}

/* Foro */
.forum{display:grid;grid-template-columns:minmax(0,380px) minmax(0,1fr);gap:clamp(24px,3.5vw,48px);align-items:start}
@media (max-width:920px){.forum{grid-template-columns:minmax(0,1fr)}}
.ficha{background:var(--card);border:2px solid var(--ink);border-radius:16px;overflow:hidden;position:sticky;top:90px}
@media (max-width:920px){.ficha{position:static}}
.ficha-top{display:flex;justify-content:space-between;gap:8px;align-items:center;padding:12px 16px;background:var(--ink);color:var(--on-ink);font:500 .75rem/1 var(--f-body);letter-spacing:.1em;text-transform:uppercase}
.ficha-top b{width:46px;height:12px;background:repeating-linear-gradient(-45deg,var(--signal) 0 6px,var(--tape) 6px 12px);border:1px solid var(--on-ink)}
.ficha form{display:grid;gap:14px;padding:18px 16px 20px}
.fld{display:grid;gap:6px;min-width:0}
.fld label{font:600 .75rem/1.3 var(--f-body);letter-spacing:.06em;text-transform:uppercase}
.fld small{font-size:.75rem;color:var(--muted)}
.fld .err{color:var(--danger);font:500 .75rem/1.3 var(--f-body)}
input[type=text],select,textarea{font:400 1rem/1.4 var(--f-body);color:var(--ink);background:var(--bg);border:1.5px solid var(--muted);border-radius:8px;padding:10px 12px;width:100%;min-width:0}
textarea{resize:vertical;min-height:112px}
input[aria-invalid=true],select[aria-invalid=true],textarea[aria-invalid=true]{border-color:var(--danger)}
.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
@media (max-width:420px){.two{grid-template-columns:minmax(0,1fr)}}
.note{font-size:.8125rem;color:var(--muted)}
.live{display:flex;flex-wrap:wrap;gap:8px 28px;padding-bottom:16px;border-bottom:1px solid var(--line);margin-bottom:16px}
.live div{display:flex;align-items:baseline;gap:8px}
.live b{font:800 clamp(1.625rem,1.4rem + 1vw,2.125rem)/1 var(--f-display);font-variant-numeric:tabular-nums}
.live span{font:400 .75rem/1.2 var(--f-body);color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.tools{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;margin-bottom:16px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{font:500 .75rem/1 var(--f-body);padding:10px 12px;border:1.5px solid var(--line);background:var(--card);cursor:pointer;border-radius:999px}
.chip[aria-pressed=true]{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.sort{display:flex;align-items:center;gap:8px;font-size:.75rem;color:var(--muted)}
.sort select{width:auto;padding:7px 10px;font-size:.875rem}
.list{display:grid;gap:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;display:grid;gap:10px;min-width:0;animation:rise .4s ease both}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.card-top{display:flex;flex-wrap:wrap;gap:6px 12px;justify-content:space-between;align-items:center}
.meta{font:400 .75rem/1.3 var(--f-body);color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.card h3{font-size:clamp(1.1rem,1rem + .5vw,1.3rem);line-height:1.2;overflow-wrap:anywhere}
.card p{overflow-wrap:anywhere;white-space:pre-wrap;font-size:var(--step--1)}
.tag{display:inline-block;font:500 .75rem/1 var(--f-body);padding:5px 8px;background:var(--surface);border:1px solid var(--line);color:var(--muted);border-radius:4px}
.st{font:600 .6875rem/1 var(--f-body);letter-spacing:.05em;text-transform:uppercase;padding:6px 9px;border:1.5px solid var(--muted);color:var(--muted);white-space:nowrap;border-radius:999px}
.st.evaluacion{background:var(--signal-soft);border-color:var(--signal);color:var(--ink)}
.st.equipo{background:var(--ink);border-color:var(--ink);color:var(--on-ink)}
.st.recuperado{background:var(--accent-soft);border-color:var(--accent);color:var(--accent-ink)}
.acts{display:flex;flex-wrap:wrap;gap:8px 10px;align-items:center;padding-top:6px}
.act{font:500 .8125rem/1 var(--f-body);display:inline-flex;gap:8px;align-items:center;padding:10px 14px;border:1.5px solid var(--ink);background:transparent;cursor:pointer;border-radius:999px}
.act[aria-pressed=true]{background:var(--btn-bg);border-color:var(--btn-bg);color:#fff}
.act.plain{border-color:var(--line)}
.thread{display:grid;gap:10px;border-top:1px dashed var(--line);padding-top:12px}
.reply{font-size:.875rem;display:grid;gap:2px}
.reply .meta{text-transform:none;letter-spacing:0}
.reply-form{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:end}
.reply-form textarea{min-height:64px}
.reply-form .nm{grid-column:1/-1}
.empty{border:2px dashed var(--line);padding:32px 20px;text-align:center;color:var(--muted);display:grid;gap:6px;justify-items:center;border-radius:14px}
.empty b{font:700 1.25rem/1.2 var(--f-display);color:var(--ink)}

/* Fotos */
.drop{display:grid;gap:8px;justify-items:start}
.file-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border:1.5px dashed var(--muted);border-radius:10px;background:var(--bg);cursor:pointer;font:500 .875rem/1.2 var(--f-body);width:100%;justify-content:center}
.file-btn:hover{border-color:var(--accent);color:var(--accent-ink)}
.file-btn input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.file-btn:focus-within{outline:3px solid var(--ring);outline-offset:2px}
.prev{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;width:100%}
.prev:empty{display:none}
.thumb{position:relative;aspect-ratio:1;border-radius:10px;overflow:hidden;border:1px solid var(--line)}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.thumb button{position:absolute;top:4px;right:4px;width:26px;height:26px;border-radius:50%;border:0;background:var(--ink);color:var(--on-ink);cursor:pointer;font:700 .9rem/1 var(--f-body);display:grid;place-items:center}
.photos{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:8px}
.photos button{padding:0;border:1px solid var(--line);border-radius:10px;overflow:hidden;cursor:zoom-in;background:var(--surface);aspect-ratio:4/3}
.photos img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .25s}
.photos button:hover img{transform:scale(1.05)}
dialog#lb{border:0;padding:0;background:transparent;max-width:min(94vw,900px)}
dialog#lb::backdrop{background:rgba(10,16,22,.8)}
dialog#lb img{display:block;max-width:100%;max-height:82vh;margin:auto;border-radius:12px}
dialog#lb button{display:block;margin:12px auto 0}

/* Equipo */
.team{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px}
.member{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px 18px;text-align:center;display:grid;gap:6px;justify-items:center}
.avatar{width:64px;height:64px;border-radius:50%;display:grid;place-items:center;font:800 1.3rem/1 var(--f-display);color:#fff;margin-bottom:6px}
.member b{font:700 1rem/1.2 var(--f-display)}
.member span{font-size:.8125rem;color:var(--muted)}

/* Aliados */
.allies{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:clamp(24px,4vw,56px);align-items:start}
@media (max-width:920px){.allies{grid-template-columns:minmax(0,1fr)}}
.ally-group+.ally-group{margin-top:28px}
.ally-group h3{font:700 .8125rem/1 var(--f-display);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
.ally-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.ally{min-height:96px;border:1.5px solid var(--ink);background:var(--card);display:grid;place-items:center;padding:12px;text-align:center;font:700 1.0625rem/1.2 var(--f-display);border-radius:12px}
.ally.ph{border:1.5px dashed var(--muted);background:transparent;color:var(--muted);font:400 .75rem/1.4 var(--f-body)}

.foot{padding-block:32px 44px;display:flex;flex-wrap:wrap;gap:12px 32px;justify-content:space-between;color:var(--muted);font-size:.875rem}
.toast{position:fixed;left:50%;bottom:calc(16px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);max-width:min(92vw,520px);background:var(--ink);color:var(--on-ink);padding:12px 16px;font:500 .875rem/1.4 var(--f-body);border-left:6px solid var(--signal);border-radius:8px;z-index:50}
.toast[hidden]{display:none}

/* Aparición al scroll */
.rv{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease}
.rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}.btn,.pillar,.card{transition:none;animation:none}html{scroll-behavior:auto}}


/* Imágenes grandes: portada y casos a todo el ancho */
.hero{grid-template-columns:minmax(0,1fr);gap:clamp(28px,4vw,48px);padding-block:clamp(32px,5vw,64px)}
.hero h1{max-width:20ch}
.hero-fig .ba,.case .ba{border-width:3px;border-radius:20px;box-shadow:var(--shadow)}
.hero-fig figcaption{font-size:.8125rem}
.ba-handle{width:5px;margin-left:-2.5px}
.ba-handle span{width:60px;height:60px;margin:-30px 0 0 -30px;font-size:1.2rem}
.ba-tag{top:16px;padding:8px 14px;font-size:.8125rem}
.ba-tag.b{left:16px}.ba-tag.a{right:16px}
.cases{grid-template-columns:minmax(0,1fr);gap:clamp(48px,7vw,88px)}
.case{grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);column-gap:clamp(24px,4vw,56px);row-gap:16px}
.case .ba{grid-column:1/-1}
.case h3{grid-column:1;font-size:clamp(1.5rem,1.2rem + 1.2vw,2.1rem)}
.case p{grid-column:1;font-size:var(--step-0)}
.case .spec{grid-column:2;grid-row:2/span 2;align-self:start;grid-template-columns:minmax(0,1fr);gap:14px;border-top:0;border-left:2px solid var(--line);padding:0 0 0 clamp(16px,3vw,32px)}
.case .spec dd{font-size:1rem}
@media (max-width:760px){
  .case{grid-template-columns:minmax(0,1fr)}
  .case h3,.case p,.case .spec{grid-column:1}
  .case .spec{grid-row:auto;border-left:0;border-top:1px solid var(--line);padding:12px 0 0;grid-template-columns:repeat(3,minmax(0,1fr))}
  .ba-handle span{width:48px;height:48px;margin:-24px 0 0 -24px}
  .ba-tag{top:10px;padding:6px 10px;font-size:.6875rem}.ba-tag.b{left:10px}.ba-tag.a{right:10px}
}

/* Acceso secreto al Drive del equipo */
.secret{color:inherit;text-decoration:none;font:inherit;cursor:default}
.secret:hover,.secret:focus-visible{cursor:pointer;color:var(--accent-ink)}
</style>
</head>
