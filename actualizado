<script>
(function(){
'use strict';
var $=function(s,r){return (r||document).querySelector(s)};
function h(tag,props){
  var el=document.createElement(tag);
  if(props){for(var k in props){var v=props[k];if(v==null||v===false)continue;
    if(k==='class')el.className=v;
    else if(k==='text')el.textContent=v;
    else if(k.slice(0,2)==='on')el.addEventListener(k.slice(2),v);
    else el.setAttribute(k,v===true?'':v);}}
  for(var i=2;i<arguments.length;i++){var kid=arguments[i];
    (Array.isArray(kid)?kid:[kid]).forEach(function(c){if(c==null||c===false)return;el.append(c.nodeType?c:document.createTextNode(c));});}
  return el;
}

/* ---------- Antes / después con imágenes ---------- */
function slider(before,after,label,start,eager){
  var wrap=h('div',{class:'ba'});
  wrap.style.setProperty('--p',(start||50)+'%');
  var mk=function(src,alt,cls){
    return h('div',{class:cls},h('img',{src:src,alt:alt,draggable:'false',decoding:'async',loading:eager?'eager':'lazy'}));
  };
  var afterL=mk(after,label+': después de la intervención (imagen referencial)','ba-layer');
  var beforeL=mk(before,label+': antes de la intervención','ba-layer ba-before');
  var range=h('input',{type:'range',min:'0',max:'100',value:String(start||50),class:'ba-range','aria-label':'Comparar antes y después de '+label});
  range.addEventListener('input',function(){wrap.style.setProperty('--p',range.value+'%')});
  wrap.append(afterL,beforeL,
    h('span',{class:'ba-tag b',text:'Antes'}),h('span',{class:'ba-tag a',text:'Después'}),
    h('div',{class:'ba-handle'},h('span',{text:'<>'})),range);
  return wrap;
}

/* ---------- Tema ---------- */
(function(){
  var root=document.documentElement;
  try{var t=localStorage.getItem('ec_theme');if(t)root.setAttribute('data-theme',t)}catch(e){}
  $('#theme').addEventListener('click',function(){
    var dark=root.getAttribute('data-theme')==='dark'||(!root.getAttribute('data-theme')&&matchMedia('(prefers-color-scheme: dark)').matches);
    var next=dark?'light':'dark';root.setAttribute('data-theme',next);
    try{localStorage.setItem('ec_theme',next)}catch(e){}
  });
})();

/* ---------- Hero y casos ---------- */
$('#hero-fig').prepend(slider('data:image/webp;base64,','data:image/webp;base64,','Esquina de calle Viollier',50,true));
var CASES=[
  {b:'data:image/webp;base64,',a:'data:image/webp;base64,',name:'Multicancha recuperada',m2:'Multicancha',dias:'Deporte y mural',vol:'Familias',desc:'Piso renovado, arcos y aros nuevos, jardineras y un mural comunitario: un lugar para que los niños vuelvan a jugar cerca de casa.'},
  {b:'data:image/webp;base64,',a:'data:image/webp;base64,',name:'Esquina con mural y reciclaje',m2:'Esquina',dias:'Luz y reciclaje',vol:'Todo público',desc:'La basura y los escombros dan paso a bancas, plantas, luminarias y contenedores señalizados, con un mural hecho con el barrio.'},
  {b:'data:image/webp;base64,',a:'data:image/webp;base64,',name:'Vereda Viollier con vida de barrio',m2:'Vereda',dias:'Árboles y bancas',vol:'Adultos mayores',desc:'Vereda ordenada, árbol nuevo, bancas y mural en el muro: un espacio para sentarse, conversar y cuidar la esquina.'}
];
CASES.forEach(function(c){
  $('#cases').append(h('article',{class:'case rv'},
    slider(c.b,c.a,c.name,50),h('h3',{text:c.name}),h('p',{text:c.desc}),
    h('dl',{class:'spec'},
      h('div',null,h('dt',{text:'Espacio'}),h('dd',{text:c.m2})),
      h('div',null,h('dt',{text:'Diseño'}),h('dd',{text:c.dias})),
      h('div',null,h('dt',{text:'Para'}),h('dd',{text:c.vol})))));
});

